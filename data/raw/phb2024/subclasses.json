  {
   "id": "path-of-the-zealot",
   "class": "barbarian",
   "name": "Path of the Zealot",
   "status": "ready",
   "features": [
    {
     "level": 3,
     "name": "Divine Fury",
     "mechanics": [
      "While raging: the first creature you hit on each of your turns with a weapon or an Unarmed Strike takes extra damage = 1d6 + half your barbarian level.",
      "Damage type: Necrotic or Radiant, your choice each time."
     ]
    },
    {
     "level": 3,
     "name": "Warrior of the Gods",
     "mechanics": [
      "Healing pool of d12s: 4 dice at level 3, 5 at level 6, 6 at level 12, 7 at level 17.",
      "Bonus Action: spend any number of dice from the pool, roll them, regain Hit Points equal to the total.",
      "The pool refills after a Long Rest."
     ]
    },
    {
     "level": 6,
     "name": "Fanatical Focus",
     "mechanics": [
      "Once per active Rage: when you fail a saving throw, reroll it with a bonus equal to your Rage Damage bonus; you must use the new roll."
     ]
    },
    {
     "level": 10,
     "name": "Zealous Presence",
     "mechanics": [
      "Bonus Action: up to 10 other creatures of your choice within 60 feet gain Advantage on attack rolls and saving throws until the start of your next turn.",
      "Once per Long Rest; you can also restore the use by expending one use of Rage (no action)."
     ]
    },
    {
     "level": 14,
     "name": "Rage of the Gods",
     "mechanics": [
      "When you activate Rage, you can take a divine form for 1 minute or until you drop to 0 Hit Points. Once per Long Rest.",
      "Divine form: Fly Speed equal to your Speed, you can hover; Resistance to Necrotic, Psychic and Radiant damage.",
      "Revivification: when a creature within 30 feet would drop to 0 Hit Points, take a Reaction and expend one use of Rage to set its Hit Points to your barbarian level instead."
     ]
    }
   ],
   "verify": "Сверить с Книгой игрока 2024: числа кубов, сроки и частоту использования."
  },
